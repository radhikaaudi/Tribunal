// ============================================================================
// Tribunal evidence queries (installed GSQL). Method names match TigerGraphClient.
// Install:  gsql graph/queries/evidence.gsql   then  INSTALL QUERY ALL
// Every query takes card1 as the subject; each is a single-purpose evidence probe.
// ============================================================================

USE GRAPH TRIBUNAL

// ---- prior risk + total exposure for a card --------------------------------
CREATE QUERY ev_prior_exposure(INT card1) FOR GRAPH TRIBUNAL {
  SumAccum<DOUBLE> @@exposure;
  MaxAccum<DOUBLE> @@prior;
  start = {Card.*};
  c = SELECT s FROM start:s WHERE s.card1 == card1
        ACCUM @@prior += s.risk_max, @@exposure += s.exposure;
  PRINT @@prior AS prior, @@exposure AS exposure;
}

// ---- shared-device peer count (distinct other cards on the same device) -----
CREATE QUERY ev_shared_device(INT card1) FOR GRAPH TRIBUNAL {
  SetAccum<INT> @@peers;
  start = {Card.*};
  c   = SELECT s FROM start:s WHERE s.card1 == card1;
  txn = SELECT t FROM c:s -(SWIPED:e)- Txn:t;
  dev = SELECT d FROM txn:t -(ON_DEVICE:e)- Device:d WHERE d.is_generic == false;
  peer= SELECT t2 FROM dev:d -(ON_DEVICE:e)- Txn:t2;
  pc  = SELECT c2 FROM peer:t2 -(SWIPED:e)- Card:c2
          WHERE c2.card1 != card1 ACCUM @@peers += c2.card1;
  PRINT @@peers.size() AS peers;
}

// ---- shared rare-email peer count ------------------------------------------
CREATE QUERY ev_shared_email(INT card1) FOR GRAPH TRIBUNAL {
  SetAccum<INT> @@peers;
  start = {Card.*};
  c   = SELECT s FROM start:s WHERE s.card1 == card1;
  txn = SELECT t FROM c:s -(SWIPED:e)- Txn:t;
  em  = SELECT m FROM txn:t -(FROM_EMAIL:e)- Email:m WHERE m.is_common == false;
  peer= SELECT t2 FROM em:m -(FROM_EMAIL:e)- Txn:t2;
  pc  = SELECT c2 FROM peer:t2 -(SWIPED:e)- Card:c2
          WHERE c2.card1 != card1 ACCUM @@peers += c2.card1;
  PRINT @@peers.size() AS peers;
}

// ---- max transactions in any 24h window (velocity) -------------------------
CREATE QUERY ev_velocity(INT card1) FOR GRAPH TRIBUNAL {
  ListAccum<INT> @@dts;
  start = {Card.*};
  c   = SELECT s FROM start:s WHERE s.card1 == card1;
  txn = SELECT t FROM c:s -(SWIPED:e)- Txn:t ACCUM @@dts += t.dt;
  // sliding window computed in the app after fetch, OR here with a sort+scan
  INT best = 0; INT j = 0;
  @@dts = @@dts.sort();
  FOREACH i IN RANGE[0, @@dts.size()-1] DO
    WHILE @@dts.get(i) - @@dts.get(j) > 86400 DO j = j + 1; END;
    IF i - j + 1 > best THEN best = i - j + 1; END;
  END;
  PRINT best AS max_24h;
}

// ---- identity-mismatch score (F-flags beyond one, + distance anomaly) -------
CREATE QUERY ev_identity_mismatch(INT card1) FOR GRAPH TRIBUNAL {
  AvgAccum @@avg_f;
  MaxAccum<DOUBLE> @@maxdist;
  start = {Card.*};
  c   = SELECT s FROM start:s WHERE s.card1 == card1;
  txn = SELECT t FROM c:s -(SWIPED:e)- Txn:t
          ACCUM @@avg_f += t.f_flags, @@maxdist += t.dist1;
  DOUBLE f_score = 0;
  IF @@avg_f > 1 THEN f_score = (@@avg_f - 1) / 9.0; END;
  DOUBLE dist_anom = 0; IF @@maxdist > 500 THEN dist_anom = 0.5; END;
  DOUBLE score = f_score + dist_anom; IF score > 1 THEN score = 1; END;
  PRINT score;
}

// ---- hops to nearest KNOWN-fraud card (BFS over shared-attr links, <=4) -----
CREATE QUERY ev_path_to_fraud(INT card1) FOR GRAPH TRIBUNAL {
  OrAccum @@found; INT hops = -1;
  seed = {Card.*};
  seed = SELECT s FROM seed:s WHERE s.card1 == card1;
  visited = seed;
  frontier = seed;
  FOREACH d IN RANGE[1, 4] DO
    frontier = SELECT c2 FROM frontier:s -((SHARES_DEVICE|SHARES_EMAIL):e)- Card:c2
                 WHERE c2 NOT IN visited;
    fraud = SELECT c2 FROM frontier:c2 -(CASE_OF:e)- Case:k
              WHERE k.outcome == "confirmed_fraud" ACCUM @@found += true;
    IF @@found AND hops < 0 THEN hops = d; END;
    visited = visited UNION frontier;
    IF @@found THEN BREAK; END;
  END;
  PRINT hops;
}

// ---- similar past cases via NATIVE VECTOR SEARCH (hybrid) -------------------
CREATE QUERY ev_similar_cases(LIST<DOUBLE> sig, INT k) FOR GRAPH TRIBUNAL {
  // vectorSearch returns the top-k most similar Case vertices by sig_vec
  cases = vectorSearch({Case.sig_vec}, sig, k);
  PRINT cases[cases.case_id AS case_id, cases.outcome AS outcome,
              cases.typology AS typology, cases.action AS action_taken,
              cases.note AS note];
}
