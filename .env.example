# ---- Graph backend ----
# mock  = compute evidence in pandas from data/ CSVs (no TigerGraph needed; runs instantly)
# tigergraph = real GSQL/MCP against a running instance (for the graded submission)
CLARA_GRAPH_BACKEND=mock

# ---- TigerGraph connection (only used when backend=tigergraph) ----
TG_HOST=http://localhost
TG_GRAPHNAME=CLARA
TG_USERNAME=tigergraph
TG_PASSWORD=tigergraph
TG_SECRET=
TG_RESTPP_PORT=9000
TG_GSQL_PORT=14240

# ---- LLM (narrative + explanation only; decisions stay deterministic) ----
# provider: anthropic | openai | none  (none = template-based text, no API key needed)
CLARA_LLM_PROVIDER=gemini         # anthropic | gemini | none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest,gemini-3-flash-preview,gemini-3.6-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
